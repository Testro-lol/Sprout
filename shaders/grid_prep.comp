#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"

// Turns the raw scatter accumulators into grid fields: face velocities (plus gravity),
// per-cell composition, density, viscosity and the liquid / air classification.

layout(local_size_x = 16, local_size_y = 16) in;

const float BRIDGE_LEVEL = 0.05;
const float RESTING_LEVEL = 0.25;  // occupancy of a sparse cell lying on liquid that keeps it liquid

// Whether cell `i` holds enough particles to count as liquid on its own.
bool packed(int i) {
    vec4 sol = solid[i];
    float phi_f = float(acc[i * P.acc_stride + 4]) / MASS_SCALE * P.inv_ppc;
    return sol.w > 0.02 && phi_f > 0.04 && phi_f + sol.z > LIQUID_THR;
}

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(c, P.grid))) return;
    int i = cidx(c);
    int k = i * P.acc_stride;
    int um = acc[k], umom = acc[k + 1], vm = acc[k + 2], vmom = acc[k + 3];
    int cw = acc[k + 4];
    vec4 sol = solid[i];

    vec4 o = vec4(0.0, 0.0, FACE_EMPTY, FACE_EMPTY);
    if (sol.x <= 0.0) {
        o.z = FACE_CLOSED;
    } else if (um >= MIN_FACE_MASS) {
        o.x = (float(umom) / MOM_SCALE) / (float(um) / MASS_SCALE) / S.dt;
        o.z = 0.0;
    }
    if (sol.y <= 0.0) {
        o.w = FACE_CLOSED;
    } else if (vm >= MIN_FACE_MASS) {
        o.y = (float(vmom) / MOM_SCALE) / (float(vm) / MASS_SCALE) / S.dt - P.gravity * S.dt;
        o.w = 0.0;
    }
    vel[i] = o;
    vel0[i] = o.xy;

    float phi_f = float(cw) / MASS_SCALE * P.inv_ppc;
    // Composition: the share and mean concentration of every material in the tank, and from
    // them (and the material table) everything the solver needs to know about the cell.
    // Within a phase group density blends linearly by volume and viscosity
    // logarithmically; across groups (a cell the interface passes through, or an
    // unresolved dispersion) the dynamic viscosities are averaged by volume.
    float f[GROUPS] = float[GROUPS](0.0, 0.0, 0.0, 0.0);    // share of each phase group
    float rg[GROUPS] = float[GROUPS](0.0, 0.0, 0.0, 0.0);   // share * density
    vec3 bg = vec3(0.0);   // share * base density of groups 1 - 3 (gbase, common.glsl)
    float fv = 0.0;        // share of steam
    float lg[GROUPS] = float[GROUPS](0.0, 0.0, 0.0, 0.0);   // share * ln nu
    float sigma = 0.0;
    vec2 contact = vec2(0.0);
    float fam0 = -1.0;
    float rho = 0.0, mu = 0.0, rho_c = 0.0, nu_c = 0.0;
    bool thermal = has_cap(CAP_THERMAL);
    float T = P.heat.x, kappa = 0.0, emis = 0.0, frozen = 0.0, Craw = 0.0;
    vec4 nn = vec4(0.0, -1.0, 1.0, 0.0);  // rh: the cell's non-Newtonian material (see common.glsl)
    float chi = 0.0;
    int major = 0;
    int top_row = -1;  // the material with the largest share (the wet map's colour)
    float top_share = 0.0;
    int nmix = P.n_fam - 1;
    for (int q = 0; q < nmix; q++) mixb[i * nmix + q] = -1.0;
    bool settle = has_cap(CAP_SETTLE);
    if (settle) for (int q = 0; q < P.n_fam; q++) famocc[i * P.n_fam + q] = 0.0;
    if (cw <= 0 && has_cap(CAP_REACT)) rmask[i] = 0u;
    if (cw > 0) {
        // The first row's weight is what the explicit channels leave of the cell weight. If
        // the tank has a primary family (P.primary: the first concentrate of the first row,
        // honey in water), the two share that remainder and are one liquid here, at the
        // concentration of the pair: the diluent takes part in the exchange directly.
        int others = 0;
        for (int j = 0; j < P.n_present; j++) {
            int ch = mats[present_row(j)].ia.z;
            if (ch >= 0) others += acc[k + ch];
        }
        // Pass 1: shares and concentrations; with heat, the cell's heat capacity,
        // conductivity and from them its temperature.
        float sh[MAX_PRESENT], sc[MAX_PRESENT];
        float Csh = 0.0;
        float Cg[GROUPS] = float[GROUPS](0.0, 0.0, 0.0, 0.0);  // heat capacity per phase group
        for (int j = 0; j < P.n_present; j++) {
            sh[j] = 0.0;
            sc[j] = 1.0;
            int r = present_row(j);
            ivec4 ia = mats[r].ia;
            if (ia.z < 0 && P.primary >= 0 && r != P.primary) continue;
            int w = ia.z >= 0 ? acc[k + ia.z] : max(cw - others, 0);
            if (w <= 0) continue;
            // A cell of one material has share 1 exactly (the driver may turn the division
            // into a multiplication by a rounded reciprocal; a density one bit off from cell
            // to cell is enough to disturb a sealed, completely full tank).
            sh[j] = w >= cw ? 1.0 : clamp(float(w) / float(cw), 0.0, 1.0);
            if (ia.y >= 0 && ia.w >= 0) sc[j] = clamp(float(acc[k + ia.w]) / float(w), 0.0, 1.0);
            if (thermal) {
                float cr = sh[j] * thermal_of(uint(r), sc[j]).w;
                Csh += cr;
                Cg[ia.x] += cr;
                float kp = mats[r].th.y;
                kappa += sh[j] * (ia.y >= 0 ? mix(mats[ia.y].th.y, kp, sc[j]) : kp);
                float em = mats[r].th2.y;
                emis += sh[j] * (ia.y >= 0 ? mix(mats[ia.y].th2.y, em, sc[j]) : em);
            }
        }
        // Which materials the cell holds, for the reactions (particles.comp).
        if (has_cap(CAP_REACT)) {
            uint mask = 0u;
            for (int j = 0; j < P.n_present; j++) {
                ivec4 ia = mats[present_row(j)].ia;
                if (sh[j] * (ia.y >= 0 ? sc[j] : 1.0) > REACT_MIN) mask |= 1u << uint(j);
            }
            rmask[i] = mask;
        }
        // The temperature of each phase group present, from its own particles: liquids of
        // different groups meet at a sharp interface and keep their own temperatures (they
        // exchange heat through it, heat.comp), so a cell where lava meets water must not
        // evaluate the lava at the mean of the two. Within a group the cell's liquids mix.
        float Tg[GROUPS];
        group_temperatures(k, cw, thermal ? Csh : 0.0, Cg, T, Tg);
        // Pass 2: properties of each material at its concentration and its group's temperature.
        for (int j = 0; j < P.n_present; j++) {
            float share = sh[j];
            if (share <= 0.0) continue;
            int r = present_row(j);
            ivec4 ia = mats[r].ia;
            float s = sc[j];
            vec4 ma = mats[r].a;
            float rho_m = ma.x, lnu = ma.y, sig = ma.z;
            float Tm = Tg[ia.x];
            if (thermal) lnu += temp_law(r, Tm);
            float xp = thermal ? expansion(uint(r), s, Tm) : 1.0;
            vec2 cs = mats[r].b.xy;
            if (ia.y >= 0) {
                vec4 da = mats[ia.y].a;
                rho_m = mix(da.x, rho_m, s);
                lnu = mix(thermal ? da.y + temp_law(ia.y, Tm) : da.y, lnu, blend_share(s, mats[r].misc.z));
                sig = mix(da.z, sig, s);
                cs = mix(mats[ia.y].b.xy, cs, s);
                int fam = mats[r].ib.x;
                if (fam == 0) fam0 = s;
                else if (fam > 0) mixb[i * nmix + fam - 1] = s;
                if (settle && fam >= 0) famocc[i * P.n_fam + fam] = share * phi_f;
            }
            rho_m *= xp;
            if (thermal) {
                // Frozen liquid stays liquid to the solver, at the viscosity of
                // `frozen_viscosity` (README, "Solidification"), and takes the solid's density.
                vec4 th = thermal_of(uint(r), s);
                float fs = th.y > -1e8 ? clamp((th.y - Tm) / max(th.y - th.x, 1e-3), 0.0, 1.0) : 0.0;
                if (fs > 0.0) {
                    lnu = mix(lnu, max(lnu, P.heat2.x), fs);
                    float rs = mats[r].b.w;
                    rho_m = mix(rho_m, ia.y >= 0 ? mix(mats[ia.y].b.w, rs, s) : rs, fs);
                    frozen += share * fs;
                }
            }
            if ((mats[r].ib.y != 0 || mats[r].temp.w > 0.0 || mats[r].gr.x > 0.0) && share > nn.x) nn = vec4(share, float(r), s, 0.0);
            if (r == int(ROW_STEAM)) fv = share;
            else if (share > top_share) {
                top_share = share;
                top_row = r;
            }
            chi += share * mats[r].el.z;
            int g = ia.x;
            f[g] += share;
            rg[g] += share * rho_m;
            if (g > 0) bg[g - 1] += share * ma.x;
            lg[g] += share * lnu;
            sigma += share * sig;
            contact += share * cs;
        }
        for (int g = 0; g < GROUPS; g++) {
            if (f[g] <= 0.0) continue;
            rho += rg[g];
            mu += rg[g] * exp(lg[g] / f[g]);
            if (f[g] > f[major]) major = g;
        }
        if (f[major] > 0.0) {
            rho_c = rg[major] / f[major];
            nu_c = exp(lg[major] / f[major]);
        }
        Craw = Csh * float(cw) / MASS_SCALE;
    }
    float phi_t = phi_f + sol.z;

    // Level > 0 marks a liquid cell. Sparse spray stays "air": it gets no pressure and
    // flies ballistically until it packs densely enough to count as liquid again.
    bool has = phi_f > 0.04 && sol.w > 0.02;
    float level = has ? phi_t - LIQUID_THR : -LIQUID_THR;
    // A thin cell squeezed between two liquid ones stays liquid. Liquid that is being
    // stretched (a falling stream) is under tension, and without this a one-cell crack
    // would count as a free surface, lose that tension and tear the stream into slugs.
    if (has && level <= 0.0 && c.x > 0 && c.y > 0 && c.x < P.grid.x - 1 && c.y < P.grid.y - 1) {
        int W = P.grid.x;
        if ((packed(i - 1) && packed(i + 1)) || (packed(i - W) && packed(i + W))) level = BRIDGE_LEVEL;
        // So does a cell lying on packed liquid that holds at least a quarter of its rest
        // occupancy: the top of a pool whose level falls inside a cell. As air, its
        // particles gathered the air faces above them, which gain gravity every substep that
        // no pressure answers; they sank into the cell below while the density correction
        // lifted them back, and the momentum fed in at the surface grew into a circulation
        // (a resting layer 35 cells deep went from 0.44 to 1.7 cells/s in 24 s; now about
        // 0.01). Stray particles above a full row stay air (below a quarter), and so does a
        // cell of a non-Newtonian liquid: the plug holds the sparse top of a yield-stress
        // pile (particles.comp), which as liquid ran out 60 % further.
        else if (P.gravity > 0.0 && nn.x <= 0.0 && phi_t > RESTING_LEVEL && packed(i - W)) level = BRIDGE_LEVEL;
        // With a magnet, "lying on" is towards the pull of gravity and the field together
        // (magnet.comp, from the last substep's energy): the sparse side of a blob that a
        // magnet holds up, or the top of a dish it pulls down, is not left to fall under gravity
        // alone and be pulled back (a ferrofluid column hanging from a magnet on 1 cm cells kept
        // ~125 units of kinetic energy, ~40 % of it in its few sparse surface cells).
        else if (has_cap(CAP_MAGNET) && nn.x <= 0.0 && phi_t > RESTING_LEVEL && chi > 0.0) {
            float km = chi / P.mag.y / max(rho, 0.05);
            vec2 pull = -km * 0.5 * vec2(magc[i + 1].y - magc[i - 1].y, magc[i + W].y - magc[i - W].y) - vec2(0.0, P.gravity);
            int toward = abs(pull.x) > abs(pull.y) ? (pull.x > 0.0 ? i + 1 : i - 1) : (pull.y > 0.0 ? i + W : i - W);
            if (packed(toward)) level = BRIDGE_LEVEL;
        }
    }

    // An open cell without liquid: its region has a free surface (see rhs.comp).
    if (sol.w > 0.0 && level <= 0.0) {
        uint bit = 1u << (region[i] & REGION_MASK);
        if ((region_air & bit) == 0u) atomicOr(region_air, bit);
    }

    // The viscosity solve stops at `rigid_viscosity`; a cell that would need more is
    // stiff, and moves rigidly (rigid.comp).
    if (has_cap(CAP_RIGID | CAP_RHEO)) {
        float cap = rho * exp(P.heat2.x);
        if (mu >= cap && level > 0.0) nn.w = 1.0;
        mu = min(mu, cap);
        rh[i] = nn;
    }
    // The susceptibility of the cell's liquid (its composition, not times its occupancy:
    // magnet.comp).
    if (has_cap(CAP_MAGNET)) magc[i].x = chi;
    if (has_cap(CAP_ELASTIC)) {
        int ce = int(P.elastic.x);
        estr[i] = vec4(acc[k + ce], acc[k + ce + 1], acc[k + ce + 2], 0.0) * (P.elastic.y * P.inv_ppc / STRESS_FIX);
    }
    cell[i] = vec4(phi_f, rho, mu, level);
    comp[i] = vec4(rho, f[1], fam0, phi_t);
    if (group_sorts(1) || group_sorts(2) || group_sorts(3) || has_cap(CAP_STEAM)) gbase[i] = vec4(bg, fv);
    // Only read where phase groups meet (the drift in particles.comp, pair jumps).
    if ((P.group_mask & (P.group_mask - 1u)) != 0u) {
        aux[i] = vec4(nu_c, rho_c, f[2], f[3]);
        grho[i] = vec4(rg[0], rg[1], rg[2], rg[3]);
    }
    // w: the majority phase group, plus (row + 1) / 128 of the material with the largest
    // share for the renderer's wet map (surf_apply.comp truncates to the group).
    sprop[i] = vec4(sigma, contact, float(major) + float(top_row + 1) / 128.0);
    if (thermal) {
        therm[i] = vec4(T, Craw, kappa, frozen);
        // heat.comp reads the emissivity here, then stores its result; without conduction
        // there is no heat pass and the particles must find nothing to take.
        dheat[i] = vec4(P.heat.y > 0.0 ? emis : 0.0, 0.0, 0.0, 0.0);
    }
    if (level <= 0.0) pres[i] = vec2(0.0);
}
