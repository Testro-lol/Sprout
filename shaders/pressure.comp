#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"

// One red-black SOR half-sweep over both potentials (pressure and density correction).
// They persist between substeps, so every solve starts from the previous answer and only
// has to chase what changed.

layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform PC {
    uint parity;
} pc;

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(c, P.grid))) return;
    if (uint((c.x + c.y) & 1) != pc.parity) return;
    int i = cidx(c);
    vec4 r = prhs[i];
    if (r.z == 0.0) return;
    int W = P.grid.x;
    vec4 w = pw[i];
    vec2 p = (r.xy + w.x * pres[i - 1] + w.y * pres[i + 1] + w.z * pres[i - W] + w.w * pres[i + W]) * r.z;
    vec2 old = pres[i];
    pres[i] = old + P.omega * (p - old);
}
