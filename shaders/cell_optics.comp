#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#include "optics.glsl"

// What the liquid in each cell looks like, for the renderer (README, "Look"). Run once per
// rendered frame, after the last substep, from what that substep scattered to the grid:
// the share and concentration of every material in the cell (as grid_prep.comp reads
// them), each phase group's temperature, the cell's velocity, and the optics table. The particles' own
// splat (render.rs) gives the sharp shapes; these soft fields give their colour and
// manner, at the cell's resolution, which is finer than any blend the eye can follow.
//
// Per cell, ten vec4 (one texel in each layer of an RGBA16F array image, so that the
// composite gets them bilinearly filtered by the sampler), each premultiplied by the liquid's
// occupancy (so that the composite can interpolate between cells, empty ones included):
//   0  absorption (linear RGB) and scattering coefficients of the aqueous liquids x their share
//   1  the same for the other groups: immiscible liquids never blend colours
//   2  opacity, scattering, metal, gloss
//   3  emission (linear RGB, from the temperature), speed / fast speed
//   4  body, foam, aqueous share, total
//   5  frozen colour (linear RGB) of the aqueous liquids x their frozen share
//   6  the same for the other groups
//   7  frozen share of the aqueous liquids, of the others; velocity (cells / s)
//   8  stain, glint, iridescence, crackle (the effects of composite.frag)
//   9  the key light that reaches the cell through the liquid above it (linear RGB, filled
//      in by light.comp), quenched skin share of a melt (below)
//  10  drying time (s, for the film map: film.comp); not smoothed
//  11  absorption and scattering of the dense groups (liquid metals, melts) x their share;
//      layer 1 then holds the oil-like group alone, 5 a their share and 6 a their frozen share
// A concentrate's coefficients blend with its diluent's linearly in its concentration, as a
// dissolved dye's absorbance does (Beer's law), and so does every other property.
// A frozen share loses gloss here; its colour is kept apart (layers 5 - 7) so that the
// composite can draw ice with a crisp outline instead of fading it into the liquid.
// optics_blur.comp then smooths all of them over 3 x 3 cells.
//
// The skin of a melt (README, "Heat"): where lava meets water or air, its surface is far
// colder than the cell's mean. With the half cell of melt behind it conducting
// g = 2 kappa, the face settles where g (T - Ts) equals what leaves it: the contact
// coefficient to water, h_c (Ts - Tw), or the air film plus radiation. Against water at
// 3000 W/m2K that is ~200 deg C, against air ~900: both below lava's solidus, so its surface
// shows a crust from the moment it meets either (a pillow under water, a skin in the air),
// long before the cell's own temperature has fallen that far. The share of the face's
// temperature in the freezing range is the skin share; the crust of composite.frag draws it.

layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform OPC {
    float inv_speed;   // 1 / the speed that counts as fast (cells / s)
} OP;

layout(std430, set = 0, binding = 57) readonly buffer OptBuf { Optics optics[]; };
layout(set = 0, binding = 58, rgba16f) uniform writeonly image2DArray cellopt;
// The film map's tile flags (film_tiles.comp): section 4, liquid (bit 0) and staining liquid
// (bit 1) in the tile's cells; the caller clears it first.
layout(std430, set = 0, binding = 74) buffer FilmTileBuf { uint ftile[]; };

// How fast a diluent's own tint gives way to its concentrate's: exp(-DILUENT_FADE s).
const float DILUENT_FADE = 24.0;

// Occupancy of a cell (1 = rest), from its scattered weight.
float occ_of(ivec2 q) {
    if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, P.grid))) return 0.0;
    return min(float(acc[cidx(q) * P.acc_stride + 4]) / MASS_SCALE * P.inv_ppc, 1.0);
}

// Signed distance to the solids at a cell's centre (the mean of its four corner nodes).
float sdf_cell(ivec2 q) {
    q = clamp(q, ivec2(0), P.grid - 1);
    int w1 = P.grid.x + 1, k = q.y * w1 + q.x;
    return 0.25 * (sdf[k] + sdf[k + 1] + sdf[k + w1] + sdf[k + w1 + 1]);
}

// Share of a cell's liquid that is aqueous (the weight not in another group's channels,
// for the tank's first present row being aqueous; else from the channels).
float aq_share(ivec2 q) {
    if (any(lessThan(q, ivec2(0))) || any(greaterThanEqual(q, P.grid))) return 0.0;
    int kq = cidx(q) * P.acc_stride;
    int cwq = acc[kq + 4];
    if (cwq <= 0) return 0.0;
    int others = 0, aqw = 0;
    for (int j = 0; j < P.n_present; j++) {
        int r = present_row(j);
        ivec4 ia = mats[r].ia;
        if (ia.z < 0) continue;
        int w = acc[kq + ia.z];
        others += w;
        if (ia.x == 0 && r != int(ROW_STEAM)) aqw += w;
    }
    // The first row's weight is the rest.
    int rest = max(cwq - others, 0);
    if (mats[present_row(0)].ia.x == 0) aqw += rest;
    return clamp(float(aqw) / float(cwq), 0.0, 1.0);
}

// render.rs had it per particle: the visible glow of a grey body at T (deg C).
vec3 glow(float T) {
    float K = T + 273.15;
    if (K < 800.0) return vec3(0.0);
    float level = clamp(2.0 - 1600.0 / K, 0.0, 1.0);
    vec3 c = vec3(1.0, 1.677 * exp(-2575.0 / K), 3.89 * exp(-7353.0 / K));
    return c / max(c.r, max(c.g, c.b)) * level * level * 1.6;
}

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (any(greaterThanEqual(c, P.grid))) return;
    int i = cidx(c);
    int k = i * P.acc_stride;
    int cw = acc[k + 4];
    vec4 o0 = vec4(0.0), o1 = vec4(0.0), o2 = vec4(0.0), o3 = vec4(0.0), o4 = vec4(0.0);
    vec4 o5 = vec4(0.0), o6 = vec4(0.0), o7 = vec4(0.0), o8 = vec4(0.0), o9 = vec4(0.0), o10 = vec4(0.0), o11 = vec4(0.0);
    if (cw > 0) {
        bool thermal = has_cap(CAP_THERMAL);
        float T = thermal ? therm[i].x : P.heat.x;
        int others = 0, wsteam = 0;
        for (int j = 0; j < P.n_present; j++) {
            int ch = mats[present_row(j)].ia.z;
            if (ch >= 0) others += acc[k + ch];
            if (present_row(j) == int(ROW_STEAM) && ch >= 0) wsteam = acc[k + ch];
        }
        // Steam has no look of its own: the cell's look is that of the liquid in it alone
        // (composite.frag fills a pocket of vapour from the liquid around it).
        int cl = max(cw - wsteam, 1);
        float occ = min(float(cw - wsteam) / MASS_SCALE * P.inv_ppc, 1.0);
        // Each phase group's own temperature (as grid_prep.comp has it): a drop of lava in
        // water glows and freezes at its own heat, not at the cell's mean with the water.
        float Tg[GROUPS];
        {
            float Csh = 0.0;
            float Cg[GROUPS] = float[GROUPS](0.0, 0.0, 0.0, 0.0);
            if (thermal) {
                for (int j = 0; j < P.n_present; j++) {
                    int r = present_row(j);
                    ivec4 ia = mats[r].ia;
                    if (ia.z < 0 && P.primary >= 0 && r != P.primary) continue;
                    int w = ia.z >= 0 ? acc[k + ia.z] : max(cw - others, 0);
                    if (w <= 0) continue;
                    float sh = w >= cw ? 1.0 : clamp(float(w) / float(cw), 0.0, 1.0);
                    float s = (ia.y >= 0 && ia.w >= 0) ? clamp(float(acc[k + ia.w]) / float(w), 0.0, 1.0) : 1.0;
                    float cr = sh * thermal_of(uint(r), s).w;
                    Csh += cr;
                    Cg[ia.x] += cr;
                }
            }
            group_temperatures(k, cw, Csh, Cg, T, Tg);
        }
        vec4 aq = vec4(0.0), ot = vec4(0.0), opt = vec4(0.0), sty = vec4(0.0);
        // The aqueous liquids' absorption in two parts: the plain liquids and diluent parts
        // (water), and the concentrates; and the concentrate share of the aqueous liquid.
        vec4 aq_plain = vec4(0.0), aq_conc = vec4(0.0);
        float c_aq = 0.0;
        vec4 iaq = vec4(0.0), iot = vec4(0.0), fx = vec4(0.0);
        // The dense liquids (liquid metals, melts) apart from the oil-like ones: their
        // absorption, share and frozen share, so that a drop of lava in oil keeps its own
        // look instead of tinting the cells around it.
        vec4 dense = vec4(0.0);
        float wden = 0.0, fden = 0.0;
        vec2 fz = vec2(0.0);
        vec3 em = vec3(0.0);
        float waq = 0.0, wot = 0.0, skin = 0.0;
        // The share of aqueous liquid in this cell (skin against water inside the cell).
        float waq_here = aq_share(c);
        for (int j = 0; j < P.n_present; j++) {
            int r = present_row(j);
            ivec4 ia = mats[r].ia;
            if (ia.z < 0 && P.primary >= 0 && r != P.primary) continue;
            int w = ia.z >= 0 ? acc[k + ia.z] : max(cw - others, 0);
            if (w <= 0 || r == int(ROW_STEAM)) continue;
            float sh = clamp(float(w) / float(cl), 0.0, 1.0);
            float s = (ia.y >= 0 && ia.w >= 0) ? clamp(float(acc[k + ia.w]) / float(w), 0.0, 1.0) : 1.0;
            Optics o = optics[r];
            vec4 lab = o.absorb, op = o.opt, st = o.sty, ef = o.fx;
            vec3 labs = o.solid.rgb;
            if (ia.y >= 0) {
                Optics d = optics[ia.y];
                // (The absorption is replaced below, with the diluent's tint fading.)
                lab = mix(d.absorb, o.absorb, s);
                labs = mix(d.solid.rgb, labs, s);
                op = mix(d.opt, op, s);
                st = mix(d.sty, st, s);
                ef = mix(d.fx, ef, s);
            }
            // Frozen share at its group's temperature (as grid_prep.comp has it).
            float Tm = Tg[ia.x];
            float fs = 0.0;
            if (thermal) {
                vec4 th = thermal_of(uint(r), s);
                fs = th.y > -1e8 ? clamp((th.y - Tm) / max(th.y - th.x, 1e-3), 0.0, 1.0) : 0.0;
                op.w *= 1.0 - 0.6 * fs;
                op.x = mix(op.x, max(op.x, 0.6), fs);
            }
            if (o.idx.y == 0) {
                aq += sh * lab;
                if (ia.y >= 0) {
                    aq_plain += sh * (1.0 - s) * optics[ia.y].absorb;
                    aq_conc += sh * s * o.absorb;
                    c_aq += sh * s;
                } else {
                    aq_plain += sh * o.absorb;
                }
                waq += sh;
                iaq += sh * fs * vec4(labs, 0.0);
                fz.x += sh * fs;
            } else {
                if (o.idx.y == 1) ot += sh * lab;
                else {
                    dense += sh * lab;
                    wden += sh;
                    fden += sh * fs;
                }
                wot += sh;
                iot += sh * fs * vec4(labs, 0.0);
                fz.y += sh * fs;
            }
            // The quenched skin of a melt that crusts (a crackle look) at its group's
            // temperature, against the liquid and air next to it (see the top).
            if (thermal && ia.x == 3 && ef.w > 0.01 && Tm > 0.0) {
                vec4 th = thermal_of(uint(r), s);
                if (th.y > -1e8) {
                    float g = 2.0 * mats[r].th.y;
                    float hc = P.heat2.w, Tw = min(Tg[0], 100.0);
                    float Ta = P.heat.x + 273.15;
                    float ts_w = (g * Tm + hc * Tw) / max(g + hc, 1e-12);
                    float ts_a = Tm;
                    for (int it = 0; it < 4; it++) {
                        float K = ts_a + 273.15;
                        float h = P.heat.z + st.w * P.heat.w * (K * K + Ta * Ta) * (K + Ta);
                        ts_a = (g * Tm + h * P.heat.x) / max(g + h, 1e-12);
                    }
                    float range = max(th.y - th.x, 1e-3);
                    float sk_w = clamp((th.y - ts_w) / range, 0.0, 1.0);
                    float sk_a = clamp((th.y - ts_a) / range, 0.0, 1.0);
                    // Which of the two its faces meet: the four neighbours' liquid (aqueous
                    // there, from their group sums) and air.
                    float to_air = 0.0, to_water = waq_here;
                    for (int q = 0; q < 4; q++) {
                        ivec2 nq = c + ivec2(q == 0 ? -1 : q == 1 ? 1 : 0, q == 2 ? -1 : q == 3 ? 1 : 0);
                        if (sdf_cell(nq) < 0.0) continue;
                        float on = occ_of(nq);
                        to_air += 1.0 - on;
                        to_water += on * aq_share(nq);
                    }
                    skin = max(skin, sh * max(sk_w * clamp(to_water, 0.0, 1.0), sk_a * clamp(to_air, 0.0, 1.0)));
                }
            }
            opt += sh * op;
            fx += sh * ef;
            sty += sh * st;
            em += sh * glow(Tm) * st.w;
        }
        // Speed: the face velocities around the cell.
        vec4 v = vel[i];
        vec2 u = vec2(face_live(v.z) ? v.x : 0.0, face_live(v.w) ? v.y : 0.0);
        float speed = min(length(u) * OP.inv_speed, 1.5);
        // The diluent's own tint gives way far faster than its share, by the concentrate share
        // of the cell's aqueous liquid (dissolved, or in particles of their own beside it):
        // water's blue is the look of a body of clear water, many times stronger than its
        // real absorption, and kept in proportion it turned a little syrup in it green, as a
        // blue and a yellow filter do (a tenth of syrup is already pale gold).
        if (waq > 0.0) aq = aq_plain * exp(-DILUENT_FADE * c_aq / waq) + aq_conc;
        o0 = aq * occ;
        o1 = ot * occ;
        o2 = opt * occ;
        // A quenched skin is far colder than the melt under it: it glows (and lights its
        // surroundings) only through its cracks.
        em *= 1.0 - 0.6 * clamp(skin, 0.0, 1.0);
        o3 = vec4(em, speed) * occ;
        o4 = vec4(sty.x, sty.y, waq, waq + wot) * occ;
        o5 = vec4(iaq.rgb, wden) * occ;
        o6 = vec4(iot.rgb, fden) * occ;
        o11 = dense * occ;
        // The cell's velocity at its centre (the mean of the faces around it), for effects
        // that move with the liquid.
        vec4 vr = vel[min(i + 1, P.grid.x * P.grid.y - 1)], vt = vel[min(i + P.grid.x, P.grid.x * P.grid.y - 1)];
        vec2 uc = 0.5 * (u + vec2(face_live(vr.z) ? vr.x : 0.0, face_live(vt.w) ? vt.y : 0.0));
        o7 = vec4(fz, uc) * occ;
        o8 = fx * occ;
        // Mark the film map's tile (only while it is kept: P.heat3.z is its resolution).
        int fres = int(P.heat3.z);
        if (fres > 0 && occ > 0.02) {
            ivec2 dimF = P.grid * fres;
            int tiles_x = (dimF.x + 15) / 16;
            uint nt = uint(tiles_x * ((dimF.y + 15) / 16));
            ivec2 tc = c * fres / 16;
            uint bits = 1u | (fx.x > 0.15 ? 2u : 0u);   // (film.comp: STAIN_MIN)
            uint ti = 4u * nt + uint(tc.y * tiles_x + tc.x);
            if ((ftile[ti] & bits) != bits) atomicOr(ftile[ti], bits);
        }
        // The light reaching the cell (light.comp fills in rgb), the skin of a melt; its
        // drying time, for the film map.
        o9 = vec4(0.0, 0.0, 0.0, skin) * occ;
        o10 = vec4(sty.z * occ, 0.0, 0.0, 0.0);
    }
    imageStore(cellopt, ivec3(c, 0), o0);
    imageStore(cellopt, ivec3(c, 1), o1);
    imageStore(cellopt, ivec3(c, 2), o2);
    imageStore(cellopt, ivec3(c, 3), o3);
    imageStore(cellopt, ivec3(c, 4), o4);
    imageStore(cellopt, ivec3(c, 5), o5);
    imageStore(cellopt, ivec3(c, 6), o6);
    imageStore(cellopt, ivec3(c, 7), o7);
    imageStore(cellopt, ivec3(c, 8), o8);
    imageStore(cellopt, ivec3(c, 9), o9);
    imageStore(cellopt, ivec3(c, 10), o10);
    imageStore(cellopt, ivec3(c, 11), o11);
}
