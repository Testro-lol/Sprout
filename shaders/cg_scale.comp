#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#include "mg.glsl"

// Applies the warm-start rescaling of cg_init to the stored potential itself.

layout(local_size_x = 16, local_size_y = 16) in;

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (!inside_f(c)) return;
    int i = fidx(c);
    if (mgd[i] > 0.0) pres[i].x *= S.dt / S.dt_prev;
    else pres[i] = vec2(0.0);
}
