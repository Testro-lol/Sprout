#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#include "mg.glsl"

// x += alpha p, r -= alpha q (each potential with its own step length). p is the direction
// cg_apply has just written (cgp2 in the descriptor set of this iteration's parity).

layout(local_size_x = 16, local_size_y = 16) in;

void main() {
    if (ptile[group_slot()] == 0u) return;
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (!inside_f(c)) return;
    int i = fidx(c);
    if (mgd[i] <= 0.0) return;
    vec2 a = K.p_alpha;
    pres[i] += a * cgp2[i];
    mgr[i] -= a * cgq[i];
}
