#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#include "mg.glsl"

// Coarsest level (at most 64 cells; the workgroup takes up to 256), solved in one workgroup in shared memory by a fixed,
// palindromic sequence of red-black half-sweeps from zero (red, black, ..., red), which
// keeps the preconditioner symmetric.

layout(local_size_x = 256) in;

const int HALF_SWEEPS = 41;

shared vec2 sz[256];
shared vec2 sr[256];
shared float sd[256];
shared vec4 sa[256];

void main() {
    int t = int(gl_LocalInvocationIndex);
    int n = M.dim_f.x * M.dim_f.y;
    ivec2 c = ivec2(t % M.dim_f.x, t / M.dim_f.x);
    if (t < n) {
        sz[t] = vec2(0.0);
        sr[t] = mgr[M.off_f + t];
        sd[t] = mgd[M.off_f + t];
        sa[t] = mga[M.off_f + t];
    }
    barrier();
    for (int s = 0; s < HALF_SWEEPS; s++) {
        if (t < n && sd[t] > 0.0 && ((c.x + c.y) & 1) == (s & 1)) {
            vec2 sum = sr[t];
            for (int d = 0; d < 4; d++) {
                ivec2 m = c + NB[d];
                if (all(greaterThanEqual(m, ivec2(0))) && all(lessThan(m, M.dim_f))) {
                    int j = m.y * M.dim_f.x + m.x;
                    if (sd[j] > 0.0) sum += wcomp(sa[t], d) * sz[j];
                }
            }
            sz[t] = sum / sd[t];
        }
        barrier();
    }
    if (t < n) mgx[M.off_f + t] = sz[t];
}
