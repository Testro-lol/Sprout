#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#include "mg.glsl"

// Red half of the post-smoothing sweep. On level 0 (mode 1) it also forms the partial sums
// r.z and r.r that conjugate gradients needs next, while z is still in cache.

layout(local_size_x = 16, local_size_y = 16) in;

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    vec4 acc4 = vec4(0.0);
    if (inside_f(c)) {
        int i = fidx(c);
        float D = mgd[i];
        if (D > 0.0) {
            vec2 r = mgr[i];
            vec2 z = mgx[i];
            if (((c.x + c.y) & 1) == 0) {
                vec4 w = mga[i];
                vec2 sum = r;
                for (int d = 0; d < 4; d++) {
                    ivec2 n = c + NB[d];
                    if (unknown_f(n)) sum += wcomp(w, d) * mgx[fidx(n)];
                }
                z = sum / D;
                mgx[i] = z;
            }
            acc4 = vec4(r * z, r * r);
        }
    }
    if (M.mode == 1u) group_sum(acc4, group_slot());
}
