#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#include "visc.glsl"
#include "reduce.glsl"

// G^T of the weighted strain, per face:
//   mode 0 (start):     r = b - A x0 = -G^T W G u*  (x0 = u*, b = M u*), p = z = r / diag
//   mode 1 (iteration): q = M p + G^T W G p
//   mode 2 (explicit):  u = u* - M^-1 G^T W G u*  (forward Euler with the same operator,
//                       used when the viscous diffusion number is small; see mod.rs)
// with the partial sums CG needs (r.z, r.r into the first half; p.q into the second).

vec2 gts(ivec2 c, int i) {
    int W = P.grid.x;
    vec2 g = vec2(0.0);
    if (live_u(i)) {
        float c1 = closed_u(i - W) ? 1.0 : 0.5, c2 = closed_u(i + W) ? -1.0 : -0.5;
        g.x = vs[i - 1].x - vs[i].x + vs[i].z * c1 + vs[i + W].z * c2;
    }
    if (live_v(i)) {
        float d1 = closed_v(i - 1) ? 1.0 : 0.5, d2 = closed_v(i + 1) ? -1.0 : -0.5;
        g.y = vs[i - W].y - vs[i].y + vs[i].z * d1 + vs[i + 1].z * d2;
    }
    return g;
}

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (V.mode != 2u && !tile_active()) {
        if (gl_LocalInvocationIndex == 0u) part[((V.mode == 0u) ? 0u : V.half_off) + group_slot()] = vec4(0.0);
        return;
    }
    vec4 acc4 = vec4(0.0);
    if (in_grid(c) && interior(c)) {
        int i = cidx(c);
        vec2 g = gts(c, i);
        vec2 live = vec2(live_u(i) ? 1.0 : 0.0, live_v(i) ? 1.0 : 0.0);
        vec2 diag = vw[i].zw;
        if (V.mode == 2u) {
            vec4 cf = coef[i];
            vec4 v = vel[i];
            if (live.x > 0.0) v.x -= g.x / cf.z;
            if (live.y > 0.0) v.y -= g.y / cf.w;
            vel[i] = v;
        } else if (V.mode == 0u) {
            vec2 r = -g * live;
            vec2 z = r / diag;
            vr[i] = r;
            vp[i] = z;
            acc4 = vec4(dot(r, z), dot(r, r), 0.0, 0.0);
        } else {
            vec4 cf = coef[i];
            vec2 p = vp[i] * live;
            vec2 q = (vec2(cf.z, cf.w) * p + g) * live;
            vq[i] = q;
            acc4 = vec4(0.0, 0.0, dot(p, q), 0.0);
        }
    } else if (in_grid(c) && V.mode != 2u) {
        int i = cidx(c);
        if (V.mode == 0u) {
            vr[i] = vec2(0.0);
            vp[i] = vec2(0.0);
        } else {
            vq[i] = vec2(0.0);
        }
    }
    if (V.mode != 2u) group_sum(acc4, (V.mode == 0u ? 0u : V.half_off) + group_slot());
}
