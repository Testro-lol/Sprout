#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#include "visc.glsl"
#include "reduce.glsl"
#include "reduce_tail.glsl"

// G^T of the weighted strain of u*, per face:
//   mode 0 (start):     r = b - A x0 = -G^T W G u*  (x0 = u*, b = M u*), p = z = r / diag,
//                       with the partial sums of r.z and r.r; the last work group starts the
//                       solve (cg_reduce mode 4, reduce_tail.glsl)
//   mode 2 (explicit):  u = u* - M^-1 G^T W G u*  (forward Euler with the same operator,
//                       used when the viscous diffusion number is small; see mod.rs)
// The iterations apply A to their search direction themselves (visc_iter.comp).

vec2 gts(ivec2 c, int i) {
    int W = P.grid.x;
    vec2 g = vec2(0.0);
    if (live_u(i)) {
        float c1 = closed_u(i - W) ? 1.0 : 0.5, c2 = closed_u(i + W) ? -1.0 : -0.5;
        g.x = vs[i - 1].x - vs[i].x + vs[i].z * c1 + vs[i + W].z * c2;
    }
    if (live_v(i)) {
        float d1 = closed_v(i - 1) ? 1.0 : 0.5, d2 = closed_v(i + 1) ? -1.0 : -0.5;
        g.y = vs[i - W].y - vs[i].y + vs[i].z * d1 + vs[i + 1].z * d2;
    }
    return g;
}

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (V.mode == 0u && !tile_active()) {
        if (gl_LocalInvocationIndex == 0u) part[group_slot()] = vec4(0.0);
        finish_group(4u);
        return;
    }
    vec4 acc4 = vec4(0.0);
    if (in_grid(c) && interior(c)) {
        int i = cidx(c);
        vec2 g = gts(c, i);
        vec2 live = vec2(live_u(i) ? 1.0 : 0.0, live_v(i) ? 1.0 : 0.0);
        vec2 diag = vw[i].zw;
        if (V.mode == 2u) {
            vec4 cf = coef[i];
            vec4 v = vel[i];
            if (live.x > 0.0) v.x -= g.x / cf.z;
            if (live.y > 0.0) v.y -= g.y / cf.w;
            vel[i] = v;
        } else {
            vec2 r = -g * live;
            vec2 z = r / diag;
            vr[i] = r;
            vp[i] = z;
            acc4 = vec4(dot(r, z), dot(r, r), 0.0, 0.0);
        }
    } else if (in_grid(c) && V.mode == 0u) {
        int i = cidx(c);
        vr[i] = vec2(0.0);
        vp[i] = vec2(0.0);
    }
    if (V.mode == 0u) {
        group_sum(acc4, group_slot());
        finish_group(4u);   // start (reduce_tail.glsl)
    }
}
