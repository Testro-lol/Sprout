#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#include "mg.glsl"

// Starts the pressure solve from last substep's potentials (already rescaled to this
// substep's length by cg_scale): r = b - A x, plus the partial sums of b.b for the stopping test.

layout(local_size_x = 16, local_size_y = 16) in;

void main() {
    if (ptile[group_slot()] == 0u) {
        if (gl_LocalInvocationIndex == 0u) part[M.mode + group_slot()] = vec4(0.0);
        return;
    }
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    vec4 acc4 = vec4(0.0);
    if (inside_f(c)) {
        int i = fidx(c);
        float D = mgd[i];
        if (D > 0.0) {
            vec2 x = pres[i];
            vec4 w = mga[i];
            vec2 ax = D * x;
            for (int d = 0; d < 4; d++) {
                ivec2 n = c + NB[d];
                if (unknown_f(n)) ax -= wcomp(w, d) * pres[fidx(n)];
            }
            vec2 b = prhs[i].xy;
            mgr[i] = b - ax;
            acc4 = vec4(b * b, 0.0, 0.0);
        } else {
            mgr[i] = vec2(0.0);
        }
    }
    group_sum(acc4, M.mode + group_slot());
}
