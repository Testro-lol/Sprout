#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#include "optics.glsl"

// The film map (README, "Films, stains and drips"): what liquids leave on the back wall of the
// tank and on the faces of solids, FILM_RES texels per cell, kept for as long as the tank
// runs. Every liquid that wets does it, and what it leaves follows from what it is
// (material.rs works the numbers out per liquid, optics `fx`, `opt2.w`, `thermo`):
//
//   - The coat. Liquid lying against the back wall or a solid leaves a coat as it drains
//     (Landau-Levich-Derjaguin: ~20 µm of water, ~0.3 mm of blood, millimetres of honey),
//     none of a liquid that does not wet (mercury). The film takes on what the liquid against
//     it absorbs and scatters, quickly where it is of the same kind (it dissolves into it),
//     hardly where it is not (water does not wash off oil; soapy water washes anything); a
//     dry crust re-dissolves more slowly than a wet film. A stream or splash going past the
//     back wall barely touches it (in the tank the slice stands for); a pool does.
//   - Drops. Airborne drops of any liquid leave spatter on the back wall, and striking a
//     solid a splat (particles.comp); falling drips and spray droplets that land leave theirs
//     (spray.comp). They arrive through film_in / film_col (film_lay.glsl).
//   - Running down. A film thicker than what its surface pins (PIN, varying with the wall's
//     roughness from column to column) drains as a thin viscous film at the lubrication speed
//     u = g h^2 / (3 nu) (Huppert 1982), slower as it dries and thickens; the thick front of a
//     run gathers into a bead that outruns the coat behind, so a smear turns into runs.
//   - Drips. Where a run on a solid's face reaches its lower edge (nothing of the face below
//     to run onto: an overhang, the underside of a ledge), it gathers there into a pendant
//     drop, which falls once it holds more than the surface tension can (H_DRIP, about the
//     capillary length) and lands as a splat (spray.comp).
//   - Drying. Where no liquid lies on it, the volatile part evaporates at the liquid's rate
//     (its vapour pressure: alcohol fast, water slower, oil never) and its dissolved solids
//     and particles stay: water leaves nothing, brine a white crust, blood a dark stain, mud
//     a brown one. A drying film carries its solute to its thinner edge (capillary flow to
//     the pinned contact line, Deegan et al. 1997): dried drops have darker rings.
//
// Two copies of each image (layers 0, 1): this frame reads FP.parity and writes the other.
// Each 16 x 16 tile keeps its state per copy (empty, dry, wet; ftile): a tile with no liquid
// near it, nothing laid down, and no film or only dry film costs one read per cell, or
// nothing at all once both copies hold the same there.
//
// film_c (rgba16f): absorbance (RGB) and scattering of the whole film, integrated through
//                   its thickness (what it absorbs and scatters per FILM_UNIT x its thickness):
//                   films and drops add up as dyes do
// film_h (rgba16f): thickness (FILM_UNIT, 0.1 mm), volatile share 0..1 (0: dry), row + 1 of
//                   the liquid that makes up most of it, unused

layout(local_size_x = 16, local_size_y = 16) in;

layout(constant_id = 2) const uint FILM_RES_U = 4u;
const int R = int(FILM_RES_U);

layout(push_constant) uniform FPC {
    float dt;         // simulated time since the last update, s
    uint parity;      // the copy holding the film now
    float mob_scale;  // g FILM_UNIT^2 / 3 / (texel size), m^2/s x texels/s per unit^2
    float unit_cells; // FILM_UNIT in cells
    uint pool_cap;    // spray.comp's pool: the bubbles' part, the whole pool
    uint pool_all;
} FP;

layout(std430, set = 0, binding = 57) readonly buffer OptBuf { Optics optics[]; };
layout(set = 0, binding = 58, rgba16f) uniform readonly image2DArray raw;
layout(set = 0, binding = 70, rgba16f) uniform image2DArray film_c;
layout(set = 0, binding = 71, rgba16f) uniform image2DArray film_h;
layout(std430, set = 0, binding = 72) buffer FilmInBuf { uint film_in[]; };
layout(std430, set = 0, binding = 73) buffer FilmColBuf { uint film_col[]; };
// Per tile: for each copy, its state there (TILE_*); 1 if drops were laid into the tile since
// the last update; 1 if the two copies hold the same there.
layout(std430, set = 0, binding = 74) buffer FilmTileBuf { uint ftile[]; };
// The tiles that need work this frame (film_tiles.comp): after the indirect dispatch's three
// words, tile | state << 28.
layout(std430, set = 0, binding = 75) readonly buffer FilmListBuf { uint flist[]; };

// spray.comp's pool, for drips.
struct Diffuse { vec2 pos; vec2 vel; float life; float r; uint info; float z; };
layout(std430, set = 0, binding = 94) buffer DiffuseBuf { Diffuse dpart[]; };
layout(std430, set = 0, binding = 95) buffer DiffuseCtl { uint dctl[]; };
#include "pool.glsl"
#include "film_lay.glsl"

const float WALL_RATE = 3.0;    // 1/s: how fast liquid coats a solid it lies against
const float BACK_RATE = 0.4;    // 1/s: the same against the back wall
const float BACK_SLOW = 0.02;   // speed / fast speed (~10 cm/s) from which liquid stops resting on the back wall (none past 4x)
const float WASH_RATE = 0.06;   // 1/s: how fast liquid against a film exchanges with it, at rest
// Thickness a surface holds without running, units: a contact line pins a drop or the edge
// of a film this thick (more where the surface is rougher); a continuous coat thicker than
// that drains, thinning at its top and gathering at its foot (Jeffreys 1930: h ~ sqrt(nu z / (g t))).
const float PIN = 1.0;
const float LATERAL = 0.04;     // share exchanged sideways per update by a running film
const float H_MAX = 40.0;       // units (4 mm): no film is thicker
const float H_DRIP = 22.0;      // units: a pendant drop at a lower edge falls past this (~ the capillary length)
const float RING = 6.0;         // solute carried to a drying film's edge, per unit evaporated
const float DRY_MIN = 0.003;    // units: thinner, a film is gone
const float SPRAY_LIFE = 1.5;   // spray.comp: a drip's time to land
const uint SPRAY = 3u, DRIP = 16u;

shared uint s_flag;
shared ivec2 s_tile;  // this workgroup's tile (in tiles)

// The tile's cells with a halo of HALO (a solid's face takes its coat from up to two cells
// out), read once per workgroup: occupancy, speed, coat (units), volatile share (as the cell
// optics hold them, times occupancy); absorption and scattering (layers 0 + 1 + 11 + 18);
// the row that holds most of the cell + 1.
const int CT = 16 / R;
const int HALO = 2;
const int SW = CT + 2 * HALO;
shared vec4 s_a[SW * SW];
shared vec4 s_k[SW * SW];
shared float s_row[SW * SW];

int sidx(ivec2 q) {
    ivec2 l = clamp(q - (s_tile * CT - HALO), ivec2(0), ivec2(SW - 1));
    return l.y * SW + l.x;
}

const uint TILE_EMPTY = 0u, TILE_DRY = 1u, TILE_WET = 2u;

float hash1(float x) { return fract(sin(x * 127.1 + 311.7) * 43758.5453); }
uint hashu(uint x) { x ^= x >> 16; x *= 0x7feb352du; x ^= x >> 15; x *= 0x846ca68bu; x ^= x >> 16; return x; }

// Thickness a surface pins at texel column `tx` (a smooth variation over a few texels, as
// the roughness of a real wall: runs start where it holds least).
float pin_at(int tx) {
    float x = float(tx) / 2.5;
    float i = floor(x), f = x - i;
    f = f * f * (3.0 - 2.0 * f);
    return PIN * (0.45 + 1.1 * mix(hash1(i), hash1(i + 1.0), f));
}

// Signed distance to the solids at a world position (cells), bilinear in the node field.
float sdf_at(vec2 x) {
    vec2 g = clamp(x, vec2(0.0), vec2(P.grid) - 0.001);
    ivec2 i = ivec2(g);
    vec2 f = g - vec2(i);
    int w1 = P.grid.x + 1;
    int k = i.y * w1 + i.x;
    return mix(mix(sdf[k], sdf[k + 1], f.x), mix(sdf[k + w1], sdf[k + w1 + 1], f.x), f.y);
}

// A film: absorbance and scattering (integrated), thickness, volatile share, row + 1.
struct Film { vec4 a; float h, v, row; };

Film load(ivec2 t, int layer) {
    vec4 b = imageLoad(film_h, ivec3(t, layer));
    return Film(imageLoad(film_c, ivec3(t, layer)), b.x, b.y, b.z);
}

// Mobility of a film of row + 1 `row`: texels / s per unit^2 of thickness at volatile share
// 1, from the liquid's viscosity (at its reference temperature).
float mobility(float row) {
    int r = int(row + 0.5) - 1;
    if (r < 0) return 0.0;
    float nu = exp(mats[r].a.y) * P.misc.z * P.misc.z;   // m^2 / s
    return FP.mob_scale / max(nu, 1e-8);
}

// How liquid a film still is, 0 .. 1: its volatile share against that of its liquid as laid
// (a film of a liquid that never dries is always liquid). A drying film thickens and stops
// (squared: its solvent goes and its viscosity climbs).
float liquid(Film f) {
    int r = int(f.row + 0.5) - 1;
    if (r < 0 || f.h <= 0.0) return 0.0;
    float v0 = optics[r].fx.x;
    if (v0 <= 0.0) return 1.0;
    float l = clamp(f.v / v0, 0.0, 1.0);
    return l * l;
}

// Whether film at texel t is under liquid (on the back wall, liquid in its cell): it is then
// part of that liquid and does not run on its own; what runs into it merges with the liquid.
// (Decided per cell, the same from either side, so that no film appears or vanishes between
// two texels that both run.)
bool under_liquid(ivec2 t) {
    vec2 x = (vec2(t) + 0.5) / float(R);
    return s_a[sidx(t / R)].x > 0.02 && sdf_at(x) >= 0.0;
}

// Share of a film that leaves a texel downwards in this update.
float outflow(Film f, int tx) {
    float ex = f.h - pin_at(tx);
    float l = liquid(f);
    if (ex <= 0.0 || l <= 0.0) return 0.0;
    float u = mobility(f.row) * l * f.h * f.h;   // texels / s
    return min(u * FP.dt, 0.45) * ex / f.h;
}

// Adds `q` of film `src` (thickness q of it) to the sums.
void take(inout vec4 a, inout float h, inout float vh, inout float rw, inout float rq, Film src, float q) {
    if (q <= 0.0) return;
    a += src.a * (q / max(src.h, 1e-6));
    h += q;
    vh += src.v * q;
    if (q > rq) { rq = q; rw = src.row; }
}

// The full update of texel t (in a tile that needs it): what it holds next, in copy `nxt`;
// returns its state (TILE_*).
uint update(ivec2 t, ivec2 dimF, int cur, int nxt) {
    ivec2 c = t / R;
    float occ = s_a[sidx(c)].x;
    Film me = load(t, cur);
    uint fin = film_in[t.y * dimF.x + t.x];
    // (Nothing here, nothing landing, no liquid around, nothing running in from above:
    // nothing to do, before any of the neighbours' reads.)
    if (me.h <= 0.0 && fin == 0u) {
        float near = 0.0;
        for (int j = -2; j <= 2; j++)
            for (int i = -2; i <= 2; i++) near = max(near, s_a[sidx(c + ivec2(i, j))].x);
        float around = 0.0;
        for (int k = 0; k < 3; k++) {
            ivec2 tn = t + ivec2(k == 0 ? -1 : k == 1 ? 1 : 0, k == 2 ? 1 : 0);
            if (all(greaterThanEqual(tn, ivec2(0))) && all(lessThan(tn, dimF))) around += imageLoad(film_h, ivec3(tn, cur)).x;
        }
        if (near < 0.02 && around <= 0.0) {
            imageStore(film_c, ivec3(t, nxt), vec4(0.0));
            imageStore(film_h, ivec3(t, nxt), vec4(0.0));
            return TILE_EMPTY;
        }
    }
    vec2 x = (vec2(t) + 0.5) / float(R);
    float sd = sdf_at(x);
    bool solid_here = sd < 0.0;
    float inv_r = 1.0 / float(R);
    bool near_edge = abs(sd) < 0.75;

    // ---- running down -------------------------------------------------------------------
    // Out of this texel into the one below (unless that is the other surface or the floor),
    // in from the one above (unless it is), and a little to and from each side while wet.
    // (Whether a neighbour lies on the same surface needs the distance field only within a
    // texel or so of a solid's outline.)
    vec4 an = me.a;
    float hn = me.h, vhn = me.v * me.h, rw = me.row, rq = me.h;
    bool below_same = t.y > 0 && (!near_edge || (sdf_at(x - vec2(0.0, inv_r)) < 0.0) == solid_here);
    bool held = under_liquid(t);
    if (me.h > 0.0 && below_same && !held) {
        float o = outflow(me, t.x) * me.h;
        an -= me.a * (o / me.h);
        hn -= o;
        vhn -= me.v * o;
    }
    if (!held && t.y + 1 < dimF.y && !under_liquid(t + ivec2(0, 1)) && (!near_edge || (sdf_at(x + vec2(0.0, inv_r)) < 0.0) == solid_here)) {
        Film up = load(t + ivec2(0, 1), cur);
        if (up.h > 0.0) take(an, hn, vhn, rw, rq, up, outflow(up, t.x) * up.h);
    }
    // Sideways while wet; and, while drying with nothing on it, solute towards the thinner
    // side (the coffee ring), the same pairwise exchange seen from either side.
    bool contact = occ > 0.02;
    for (int k = 0; k < 4; k++) {
        ivec2 ts = t + ivec2(k == 0 ? -1 : k == 1 ? 1 : 0, k == 2 ? -1 : k == 3 ? 1 : 0);
        if (any(lessThan(ts, ivec2(0))) || any(greaterThanEqual(ts, dimF))) continue;
        if (near_edge && (sdf_at((vec2(ts) + 0.5) * inv_r) < 0.0) != solid_here) continue;
        // (Up and down only matter for the drying ring.)
        if (k >= 2 && (contact || me.v <= 0.0 || me.h <= 0.0)) continue;
        Film nb = load(ts, cur);
        if (k < 2 && !held && !under_liquid(ts)) {
            float kk = LATERAL * min(liquid(me), liquid(nb)) * step(PIN * 0.5, max(me.h, nb.h));
            if (kk > 0.0) {
                float q = kk * (nb.h - me.h);
                if (q > 0.0) take(an, hn, vhn, rw, rq, nb, q);
                else { an += me.a * (q / max(me.h, 1e-6)); hn += q; vhn += me.v * q; }
            }
        }
        float vmin = min(me.v, nb.v);
        if (!contact && vmin > 0.0 && me.h > 0.0 && nb.h > 0.0) {
            int r1 = int(me.row + 0.5) - 1, r2 = int(nb.row + 0.5) - 1;
            float e = 0.5 * ((r1 >= 0 ? optics[r1].opt2.w : 0.0) + (r2 >= 0 ? optics[r2].opt2.w : 0.0));
            float kk = clamp(RING * e * FP.dt * vmin / max(me.h + nb.h, 0.05), 0.0, 0.2);
            // (Solute flows from the thicker to the thinner, where the liquid evaporates most.)
            an -= kk * (me.h - nb.h) / (me.h + nb.h) * (me.a + nb.a);
        }
    }
    Film f = me;
    f.h = max(hn, 0.0);
    f.a = max(an, vec4(0.0));
    f.v = f.h > 1e-5 ? clamp(vhn / f.h, 0.0, 1.0) : 0.0;
    f.row = rw;

    // ---- what the liquid against it lays down or exchanges --------------------------------
    // On the back wall: the liquid in this cell. On a solid's face (within a cell and a half
    // of its edge): the liquid just outside it.
    ivec2 lc = c;
    float rate = BACK_RATE;
    if (solid_here && sd <= -1.5) rate = 0.0;
    else if (solid_here) {
        vec2 g = vec2(sdf_at(x + vec2(0.25, 0.0)) - sdf_at(x - vec2(0.25, 0.0)), sdf_at(x + vec2(0.0, 0.25)) - sdf_at(x - vec2(0.0, 0.25)));
        vec2 n = g / max(length(g), 1e-5);
        lc = ivec2(floor(x + n * (0.7 - sd)));
        lc = clamp(lc, ivec2(0), P.grid - 1);
        rate = sd > -1.5 ? WALL_RATE * (1.0 - smoothstep(0.6, 1.5, -sd)) : 0.0;
    }
    // The liquid there, bilinear between cell centres, so that a coat's edge is smooth and
    // not a staircase of cells.
    vec4 la = vec4(0.0), lk = vec4(0.0);
    occ = 0.0;
    if (rate > 0.0) {
        vec2 at = solid_here ? vec2(lc) + 0.5 : x;
        vec2 g = clamp(at - 0.5, vec2(0.0), vec2(P.grid) - 1.001);
        ivec2 i0 = ivec2(g);
        vec2 fr = g - vec2(i0);
        for (int k = 0; k < 4; k++) {
            float wq = ((k & 1) == 0 ? 1.0 - fr.x : fr.x) * ((k >> 1) == 0 ? 1.0 - fr.y : fr.y);
            int si = sidx(min(i0 + ivec2(k & 1, k >> 1), P.grid - 1));
            la += wq * s_a[si];
            lk += wq * s_k[si];
        }
        occ = la.x;
    }
    contact = occ > 0.02 && rate > 0.0;
    if (contact) {
        float o = sqrt(min(occ, 1.0));
        float lrow = s_row[sidx(lc)];
        int lr = int(lrow + 0.5) - 1;
        // What the liquid there absorbs and scatters per FILM_UNIT, the coat it leaves, its
        // volatile share.
        vec4 kl = lk / occ * FP.unit_cells;
        float coat = la.z / occ, vl = clamp(la.w / occ, 0.0, 1.0);
        // Only a body of liquid at rest wets the back: a pool, not a stream or a blob falling
        // through the air, which in the tank the slice stands for touches the back only now
        // and then (and then leaves the spatter of its drops, particles.comp). Until
        // 2026-11-18 a falling stream laid a quarter of a pool's coat, and a pour swept
        // across the tank left its path hanging in the air as an opaque smear.
        float spd = la.y / occ;
        float body = 0.0;
        for (int j = -1; j <= 1; j++)
            for (int i = -1; i <= 1; i++) body += min(s_a[sidx(c + 2 * ivec2(i, j))].x, 1.0);
        body /= 9.0;
        float rest = solid_here ? 1.0 : (1.0 - smoothstep(BACK_SLOW, 4.0 * BACK_SLOW, spd)) * smoothstep(0.55, 0.85, body);
        // (Liquid just leaving the pour's or jet's nozzle is slow too, but not a pool.)
        if (P.tool_mode == 4 && distance(P.tool_pos, x) < 2.0 * P.tool_radius + 4.0) rest = 0.0;
        // Towards its coat ...
        float add = max(coat - f.h, 0.0) * (1.0 - exp(-FP.dt * rate * o * rest));
        if (add > 0.0) {
            f.a += kl * add;
            f.v = (f.v * f.h + vl * add) / (f.h + add);
            if (add > f.h) f.row = lrow;
            f.h += add;
        }
        // ... and exchanging with it: fast with a liquid of its own kind (the film dissolves
        // into it), hardly with another, unless that is soapy; slower out of a dry crust.
        int fr0 = int(f.row + 0.5) - 1;
        bool same = fr0 < 0 || lr < 0 || optics[fr0].idx.y == optics[lr].idx.y;
        float soapy = lr >= 0 ? optics[lr].thermo.w : 0.0;
        float miscible = same ? 1.0 : mix(0.05, 1.0, soapy);
        float kx = WASH_RATE * o * (0.25 + 2.0 * spd) * miscible * (0.3 + 0.7 * liquid(f)) * mix(0.3, 1.0, rest);
        float e = 1.0 - exp(-FP.dt * kx);
        f.a = mix(f.a, kl * f.h, e);
        f.v = max(mix(f.v, vl, e), vl * o);
        if (e > 0.3 || f.h <= 0.01) f.row = lrow;
    }

    // ---- drops laid down since the last update ------------------------------------------
    if (fin != 0u) {
        uint ci = uint(cidx(c)) * 8u;
        float q = float(film_col[ci + 4u]);
        float add = float(fin) / FILM_FIX;
        if (q > 0.0) {
            vec4 ku = vec4(film_col[ci], film_col[ci + 1u], film_col[ci + 2u], film_col[ci + 3u]) / (FILM_A_FIX * q / FILM_FIX);
            float vd = float(film_col[ci + 5u]) / (256.0 * q / FILM_FIX);
            f.a += ku * add;
            f.v = (f.v * f.h + clamp(vd, 0.0, 1.0) * add) / (f.h + add);
            if (add > f.h) f.row = float(film_col[ci + 6u]);
        }
        f.h += add;
        film_in[t.y * dimF.x + t.x] = 0u;
    }

    // ---- drying ----------------------------------------------------------------------------
    // Its volatile part evaporates; what is dissolved and suspended in it stays.
    int fr = int(f.row + 0.5) - 1;
    if (!contact && f.v > 0.0 && fr >= 0) {
        float hv = f.v * f.h;
        float d = min(hv, optics[fr].opt2.w * FP.dt);
        f.h -= d;
        f.v = f.h > 1e-5 ? (hv - d) / f.h : 0.0;
        if (f.v < 0.01) f.v = 0.0;
    }

    // ---- drips ---------------------------------------------------------------------------
    // At the lower edge of a solid's face a run gathers into a pendant drop; past H_DRIP it
    // falls, taking most of it with it.
    if (solid_here && !below_same && liquid(f) > 0.2 && f.h > H_DRIP && fr >= 0 && FP.pool_cap > 0u) {
        uint hk = hashu(uint(t.x) * 73856093u ^ uint(t.y) * 19349663u ^ P.frame * 83492791u);
        // (One texel of the edge in a few lets go at a time: drops, not a curtain.)
        if ((hk & 3u) == 0u) {
            int slot = pool_take(0u, 0u, FP.pool_cap, FP.pool_all);
            if (slot >= 0) {
                float take_h = f.h - 2.0 * PIN;
                Diffuse d;
                d.pos = x - vec2(0.0, inv_r * 1.5);
                d.vel = vec2(0.0, -0.5);
                d.life = SPRAY_LIFE;
                // (A drop as wide as the capillary length allows: ~1.5 mm of water.)
                d.r = clamp(1.6e-3 / P.misc.z, 0.05, 0.4);
                d.info = SPRAY | DRIP | (uint(fr + 1) << 8) | (hk & 0xffff8000u);
                d.z = 0.0;
                dpart[slot] = d;
                f.a *= 1.0 - take_h / f.h;
                f.h -= take_h;
            }
        }
    }

    f.h = min(f.h, H_MAX);
    if (f.h < DRY_MIN) f = Film(vec4(0.0), 0.0, 0.0, 0.0);
    imageStore(film_c, ivec3(t, nxt), f.a);
    imageStore(film_h, ivec3(t, nxt), vec4(f.h, f.v, f.row, 0.0));
    return f.h <= 0.0 ? TILE_EMPTY : liquid(f) > 0.0 ? TILE_WET : TILE_DRY;
}

void main() {
    ivec2 dimF = P.grid * R;
    int tiles_x = (dimF.x + 15) / 16;
    uint ntiles = uint(tiles_x * ((dimF.y + 15) / 16));
    uint entry = flist[3u + gl_WorkGroupID.x];
    uint tile = entry & 0x0fffffffu, state = entry >> 28;
    ivec2 tc = ivec2(int(tile) % tiles_x, int(tile) / tiles_x);
    ivec2 t = tc * 16 + ivec2(gl_LocalInvocationID.xy);
    int cur = int(FP.parity), nxt = 1 - cur;
    bool inside = all(lessThan(t, dimF));
    if (state == 2u) {
        if (inside) {
            imageStore(film_c, ivec3(t, nxt), imageLoad(film_c, ivec3(t, cur)));
            imageStore(film_h, ivec3(t, nxt), imageLoad(film_h, ivec3(t, cur)));
        }
        return;
    }
    if (state == 1u) {
        if (inside) {
            imageStore(film_c, ivec3(t, nxt), vec4(0.0));
            imageStore(film_h, ivec3(t, nxt), vec4(0.0));
        }
        return;
    }
    // The full update (state 3, the same for the whole workgroup: every thread reaches the
    // barriers). The tile's cells and their halo into shared memory first.
    if (gl_LocalInvocationIndex == 0u) {
        s_flag = TILE_EMPTY;
        s_tile = tc;
    }
    barrier();
    for (int k = int(gl_LocalInvocationIndex); k < SW * SW; k += 256) {
        ivec2 q = tc * CT - HALO + ivec2(k % SW, k / SW);
        vec4 a = vec4(0.0), kk = vec4(0.0);
        float row = 0.0;
        if (all(greaterThanEqual(q, ivec2(0))) && all(lessThan(q, P.grid))) {
            float o4 = imageLoad(raw, ivec3(q, 4)).w;
            if (o4 > 0.005) {
                // (cell_optics.comp: coat in layer 10 x, volatile share in 13 z, row in 14 w.)
                a = vec4(o4, imageLoad(raw, ivec3(q, 3)).w, imageLoad(raw, ivec3(q, 10)).x, imageLoad(raw, ivec3(q, 13)).z);
                kk = imageLoad(raw, ivec3(q, 0)) + imageLoad(raw, ivec3(q, 1)) + imageLoad(raw, ivec3(q, 11)) + imageLoad(raw, ivec3(q, 18));
                row = imageLoad(raw, ivec3(q, 14)).w;
            }
        }
        s_a[k] = a;
        s_k[k] = kk;
        s_row[k] = row;
    }
    barrier();
    if (inside) atomicMax(s_flag, update(t, dimF, cur, nxt));
    barrier();
    if (gl_LocalInvocationIndex == 0u) ftile[uint(nxt) * ntiles + tile] = s_flag;
    // Every texel has read its cell's drop sums: the cell's first texel clears them (a cell's
    // texels all lie in one tile; drops only ever land in tiles that get the full update,
    // film_tiles.comp).
    barrier();
    if (inside && all(equal(t % R, ivec2(0)))) {
        uint ci = uint(cidx(t / R)) * 8u;
        if (film_col[ci + 4u] != 0u) {
            for (uint k = 0u; k < 8u; k++) film_col[ci + k] = 0u;
        }
    }
}
