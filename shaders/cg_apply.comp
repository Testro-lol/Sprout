#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#include "mg.glsl"

// q = A p and the partial sums of p.q (into the second half of the partial buffer).

layout(local_size_x = 16, local_size_y = 16) in;

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    vec4 acc4 = vec4(0.0);
    if (inside_f(c)) {
        int i = fidx(c);
        float D = mgd[i];
        if (D > 0.0) {
            vec2 p = cgp[i];
            vec4 w = mga[i];
            vec2 q = D * p;
            for (int d = 0; d < 4; d++) {
                ivec2 n = c + NB[d];
                if (unknown_f(n)) q -= wcomp(w, d) * cgp[fidx(n)];
            }
            cgq[i] = q;
            acc4 = vec4(0.0, 0.0, p * q);
        }
    }
    group_sum(acc4, M.mode + group_slot());
}
