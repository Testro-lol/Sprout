#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"

// One red-black Gauss-Seidel half-sweep of the implicit viscosity solve
//     rho (u - u*) / dt = div(mu grad u)
// on both face-velocity components. Implicit, so syrup can be far more viscous than an
// explicit step would allow. Empty faces do not couple (free surface); closed faces couple
// with zero velocity (no-slip), so wall drag scales with viscosity: water slides, syrup clings.

layout(local_size_x = 16, local_size_y = 16) in;

layout(push_constant) uniform PC {
    uint parity;
} pc;

// Below this dynamic viscosity (cells^2 / s) a neighbourhood is left alone: over a substep
// it would change the velocity by well under a part in ten thousand. Inviscid water sits
// at the 1e-4 floor of the mixing rule, so pools of plain water cost almost nothing here.
const float MIN_VISCOSITY = 0.01;

void link(inout float num, inout float den, float mu, float state, float value, float wall) {
    if (state > 1e29) return;  // empty face: free surface
    float k = P.dt * mu * (state < -1e29 ? wall : 1.0);
    num += k * value;
    den += k;
}

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (c.x < 1 || c.y < 1 || c.x >= P.grid.x - 1 || c.y >= P.grid.y - 1) return;
    if (uint((c.x + c.y) & 1) != pc.parity) return;
    int i = cidx(c);
    int W = P.grid.x;
    vec4 me = vel[i];
    if (!face_live(me.z) && !face_live(me.w)) return;

    float m00 = cell[i - W - 1].z, m10 = cell[i - W].z, m20 = cell[i - W + 1].z;
    float m01 = cell[i - 1].z, m11 = cell[i].z, m21 = cell[i + 1].z;
    float m02 = cell[i + W - 1].z, m12 = cell[i + W].z;
    if (max(max(max(m00, m10), max(m20, m01)), max(max(m11, m21), max(m02, m12))) < MIN_VISCOSITY) return;

    vec4 L = vel[i - 1], R = vel[i + 1], D = vel[i - W], U = vel[i + W];
    vec4 cf = coef[i];
    vec2 v0 = vel0[i];

    if (face_live(me.z)) {
        // u on the face between cells (i-1, j) and (i, j)
        float num = cf.z * v0.x, den = cf.z;
        link(num, den, m11, R.z, R.x, 1.0);
        link(num, den, m01, L.z, L.x, 1.0);
        link(num, den, 0.25 * (m01 + m11 + m02 + m12), U.z, U.x, 2.0);
        link(num, den, 0.25 * (m01 + m11 + m00 + m10), D.z, D.x, 2.0);
        me.x = num / den;
    }
    if (face_live(me.w)) {
        // v on the face between cells (i, j-1) and (i, j)
        float num = cf.w * v0.y, den = cf.w;
        link(num, den, m11, U.w, U.y, 1.0);
        link(num, den, m10, D.w, D.y, 1.0);
        link(num, den, 0.25 * (m10 + m11 + m20 + m21), R.w, R.y, 2.0);
        link(num, den, 0.25 * (m10 + m11 + m00 + m01), L.w, L.y, 2.0);
        me.y = num / den;
    }
    vel[i] = me;
}
