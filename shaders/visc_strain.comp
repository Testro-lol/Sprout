#version 460
#extension GL_GOOGLE_include_directive : enable
#include "common.glsl"
#include "visc.glsl"

// Weighted strain W G u of the current velocities in the active tiles, after the first
// pressure solve changed them (the inactive tiles were cleared by visc_diag and nothing has
// written them since). visc_setup takes the strain everywhere before the explicit step; the
// iterations take that of their search direction themselves (visc_iter.comp).

void main() {
    ivec2 c = ivec2(gl_GlobalInvocationID.xy);
    if (!tile_active()) return;
    if (!in_grid(c)) return;
    int i = cidx(c);
    vs[i] = strain_of_vel(i, vw[i].xy);
}
